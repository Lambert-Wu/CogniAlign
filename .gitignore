./ablations
./base_logs
./logs
./wandb

# 数据集：体积大且有数据使用协议，不进仓库
data/

# 模型权重：体积大，不进仓库
models/

# Ignore all files in the logs directory
logs/*
# 训练产物：main.py 的 log_path 是相对路径 logs/，而它必须在 modules/ 下运行，
# 所以模型权重和训练日志实际落在 modules/logs/ —— 这条别删，否则权重会进仓库
modules/logs/
# Ignore all files in the base_logs directory
base_logs/*
# Ignore all files in the ablative_logs directory
ablations/*
# Ignore all files in the wandb directory
wandb/*

docker.sh

# Ignore pycache files
__pycache__/*
*/__pycache__/*
# Ignore all .pyc files
*.pyc
# Ignore all .pyo files
*.pyo
# Ignore all .pyd files
*.pyd
# Ignore all .pdb files
*.pdb
# Ignore all .egg files
*.egg
# Ignore all .egg-info directories
*.egg-info/
# Ignore all .whl files
*.whl
# Ignore all .tar files
*.tar
# Ignore all .zip files
*.zip
# Ignore all .tar.gz files
*.tar.gz

api.txt
*.workbuddy

# WorkBuddy 工作目录：本地的工作数据（记忆、日志、会话产物），不进仓库。
# ⚠️ 光有规则不够 —— 已经被跟踪的文件不受 .gitignore 约束，
#    所以如果它已经在索引里了，还需要：
#        git rm -r --cached .workbuddy
.workbuddy/